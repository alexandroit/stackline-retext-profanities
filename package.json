    },
    {
      "name": "Mathieu Jolivet"
    },
    {
      "name": "Otacilio Saraiva Maia Neto",
      "email": "otacilio.n97@gmail.com"
    }
  ],
  "dependencies": {
    "cuss": "^2.0.0",
    "unified": "^10.0.0",
    "pluralize": "^8.0.0",
    "quotation": "^2.0.0",
    "@types/nlcst": "^1.0.0",
    "nlcst-search": "^3.0.0",
    "nlcst-to-string": "^3.0.0",
    "unist-util-position": "^4.0.0"
  },
  "remarkConfig": {
    "plugins": [
      "preset-wooorm",
      [
        "remark-lint-table-pipe-alignment",
        false
      ],
      [
        "gfm",
        {
          "tablePipeAlign": false
        }
      ],
      "./script/build-table.js"
