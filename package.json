{
  "xo": {
    "prettier": true
  },
  "bugs": {
    "url": "https://github.com/alexandroit/stackline-retext-profanities/issues"
  },
  "main": "index.js",
  "name": "@stackline/retext-profanities",
  "type": "module",
  "types": "index.d.ts",
  "author": {
    "url": "https://wooorm.com",
    "name": "Titus Wormer",
    "email": "tituswormer@gmail.com"
  },
  "funding": {
    "url": "https://opencollective.com/unified",
    "type": "opencollective"
  },
  "license": "MIT",
  "scripts": {
    "test:upstream": "node --conditions development test.js",
    "test": "npm run test:upstream",
    "build": "node scripts/check-payload.mjs",
    "test:package": "node scripts/test-package.mjs",
    "test:types": "tsc --ignoreConfig --noEmit --module NodeNext --moduleResolution NodeNext --target ES2022 --strict test/stackline-types.mts"
  },
  "homepage": "https://alexandro.net/docs/vanilla/retext-profanities/",
  "keywords": [
    "stackline",
    "npm-package",
    "retext-profanities",
    "typescript",
    "unified",
    "retext",
    "retext-plugin",
    "plugin",
    "profane",
    "profanity",
    "cuss",
    "obscene",
    "vulgar",
    "profanities",
    "maintenance-fork"
  ],
  "prettier": {
    "semi": false,
    "useTabs": false,
    "tabWidth": 2,
    "singleQuote": true,
    "trailingComma": "none",
    "bracketSpacing": false
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alexandroit/stackline-retext-profanities.git"
  },
  "description": "retext plugin to check for profane and vulgar wording",
  "directories": {},
  "sideEffects": false,
  "contributors": [
    {
      "url": "https://wooorm.com",
