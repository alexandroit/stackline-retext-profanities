  "typeCoverage": {
    "detail": true,
    "strict": true,
    "atLeast": 100,
    "ignoreCatch": true
  },
  "devDependencies": {
    "retext": "^8.0.0",
    "typescript": "7.0.2",
    "@types/node": "24.12.2"
  },
  "version": "1.0.2",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "ar-latn.d.ts",
